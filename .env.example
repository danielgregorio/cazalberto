# Copie para .env e preencha. Só o DISCORD_TOKEN é obrigatório.
DISCORD_TOKEN=

# Pasta com as trilhas do WoW (subpastas "1.0 Classic", "7.1 Return to Karazhan"...).
# Deixe vazio para desativar. No Docker, use WOW_OST_HOST_DIR no docker-compose.
# WOW_OST_DIR=D:\music\wow-ost

# Onde ficam os dados (commands.json, playlists.json) e os áudios.
# DATA_DIR=data
# AUDIO_DIR=audio_clips

# Registrar os comandos slash toda vez que o bot iniciar (padrão: não; use !sync).
# SYNC_ON_STARTUP=false
# Servidor de testes: com isso, o sync vale só nele e aparece na hora.
# DEV_GUILD_ID=

# COMMAND_PREFIX=!
# LOG_LEVEL=INFO
# LOG_FILE=bot.log
# MAX_DOWNLOAD_MB=10
