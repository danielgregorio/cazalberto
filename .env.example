# ===========================================
# Configuração do Bot Cazalberto
# ===========================================
# Copie este arquivo para .env e configure os valores

# Token do Discord (obrigatório)
# Obtenha em: https://discord.com/developers/applications
DISCORD_TOKEN=seu_token_aqui

# ===========================================
# Configuração do WoW OST (opcional)
# ===========================================
# Caminho para a pasta com as músicas do World of Warcraft
# Se não configurado, o bot procura automaticamente uma pasta 'wow-music' no diretório do projeto
# Exemplos:
#   Windows: WOW_OST_FOLDER=C:\Users\Seu Usuario\Music\wow-ost
#   Linux:   WOW_OST_FOLDER=/home/usuario/music/wow-ost
#   Mac:     WOW_OST_FOLDER=/Users/usuario/Music/wow-ost
WOW_OST_FOLDER=

# ===========================================
# Rate Limiting (opcional)
# ===========================================
# Número máximo de comandos por usuário no período (padrão: 5)
RATE_LIMIT_COMMANDS=5

# Período em segundos para o rate limiting (padrão: 10)
RATE_LIMIT_SECONDS=10
